{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Beauty and Skincare product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string" },
        "priceTk": { "type": "number" },
        "originalPrice": { "type": "number" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "image": { "type": "string", "maxLength": 1000 },
        "badge": { "type": "string", "maxLength": 50 },
        "benefit": { "type": "string", "maxLength": 500 },
        "ingredients": { "type": "string", "maxLength": 500 },
        "howToUse": { "type": "string", "maxLength": 500 },
        "inStock": { "type": "boolean" }
      },
      "required": ["id", "name", "category", "image", "benefit", "inStock"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order placed on the site",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderDate": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 20 },
        "customerAddress": { "type": "string", "maxLength": 500 },
        "deliveryLocation": { "type": "string", "enum": ["dhaka", "outside"] },
        "deliveryFee": { "type": "number" },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["পেন্ডিং", "কনফার্মড", "ডেলিভার্ড", "বাতিল"] }
      },
      "required": ["id", "orderDate", "customerName", "customerPhone", "customerAddress", "total", "status"]
    },
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Global website configuration settings",
      "type": "object",
      "properties": {
        "whatsappNumber": { "type": "string" },
        "brandTagline": { "type": "string" },
        "announcementText": { "type": "string" },
        "dhakaDeliveryFee": { "type": "number" },
        "outsideDeliveryFee": { "type": "number" },
        "codMessage": { "type": "string" },
        "adminPin": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "All beauty products in the catalog"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Recorded customer orders"
    },
    "/config/site": {
      "schema": "SiteConfig",
      "description": "Global site settings document"
    }
  }
}
